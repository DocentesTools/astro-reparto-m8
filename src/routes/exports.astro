---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { RepartoExportsView } from "@mano8/astro-reparto-m8/default-ui";
import RepartoRouteLoading from "./_components/RepartoRouteLoading.astro";
import "../scaffold/styles/reparto.css";

export function getStaticPaths() {
  return [{ params: { processId: "current" } }];
}

const processId = Astro.params.processId ?? "current";
const config = {
  apiBase: import.meta.env.PUBLIC_FA_REPARTO_API_BASE,
  apiPrefix: import.meta.env.PUBLIC_FA_REPARTO_API_PREFIX,
  docsBase: import.meta.env.PUBLIC_FA_REPARTO_DOCS_BASE,
  routes: import.meta.env.PUBLIC_FA_REPARTO_ROUTES
};
---

<StarlightPage
  frontmatter={{
    title: "Reparto exports",
    description: "Prepare final exports, backups, and revision workflows.",
    tableOfContents: false
  }}
>
  <RepartoRouteLoading />
  <RepartoExportsView client:only="react" config={config} locale={Astro.currentLocale} processId={processId}>
    <RepartoRouteLoading fallback slot="fallback" />
  </RepartoExportsView>
</StarlightPage>
