---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { RepartoAcademicYearsView } from "@mano8/astro-reparto-m8/default-ui";
import RepartoRouteLoading from "./_components/RepartoRouteLoading.astro";
import "../scaffold/styles/reparto.css";

const config = {
  apiBase: import.meta.env.PUBLIC_FA_REPARTO_API_BASE,
  apiPrefix: import.meta.env.PUBLIC_FA_REPARTO_API_PREFIX,
  docsBase: import.meta.env.PUBLIC_FA_REPARTO_DOCS_BASE,
  routes: import.meta.env.PUBLIC_FA_REPARTO_ROUTES
};
---

<StarlightPage
  frontmatter={{
    title: "Reparto academic years",
    description: "Create, edit, and archive reparto academic years.",
    tableOfContents: false
  }}
>
  <RepartoRouteLoading />
  <RepartoAcademicYearsView client:only="react" config={config} locale={Astro.currentLocale}>
    <RepartoRouteLoading fallback slot="fallback" />
  </RepartoAcademicYearsView>
</StarlightPage>
