---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { RepartoSchoolsView } from "@mano8/astro-reparto-m8/default-ui";
import "../scaffold/styles/reparto.css";

const config = {
  apiBase: import.meta.env.PUBLIC_FA_REPARTO_API_BASE,
  apiPrefix: import.meta.env.PUBLIC_FA_REPARTO_API_PREFIX
};
---

<StarlightPage
  frontmatter={{
    title: "Reparto schools",
    description: "Create and edit reparto schools (edit-only, no delete).",
    tableOfContents: false
  }}
>
  <RepartoSchoolsView client:load config={config} />
</StarlightPage>