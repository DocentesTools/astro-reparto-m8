---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { RepartoHourRequirementsView } from "@mano8/astro-reparto-m8/default-ui";
import { getRepartoDictionary, normalizeRepartoLocale } from "@mano8/astro-reparto-m8/i18n";
import RepartoRouteLoading from "./_components/RepartoRouteLoading.astro";
import "../scaffold/styles/reparto.css";

export function getStaticPaths() {
  return [{ params: { processId: "current" } }];
}

const processId = Astro.params.processId ?? "current";
const dict = getRepartoDictionary(normalizeRepartoLocale(Astro.currentLocale));
const config = {
  apiBase: import.meta.env.PUBLIC_FA_REPARTO_API_BASE,
  apiPrefix: import.meta.env.PUBLIC_FA_REPARTO_API_PREFIX
};
---

<StarlightPage
  frontmatter={{
    title: dict.requirements.pageTitle,
    description: dict.requirements.description,
    tableOfContents: false
  }}
>
  <RepartoRouteLoading />
  <RepartoHourRequirementsView client:only="react" config={config} locale={Astro.currentLocale} processId={processId}>
    <RepartoRouteLoading fallback slot="fallback" />
  </RepartoHourRequirementsView>
</StarlightPage>
