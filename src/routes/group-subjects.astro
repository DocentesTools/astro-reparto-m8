---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { RepartoGroupSubjectsView } from "@mano8/astro-reparto-m8/default-ui";
import RepartoRouteLoading from "./_components/RepartoRouteLoading.astro";
import "../scaffold/styles/reparto.css";

export function getStaticPaths() {
  return [{ params: { processId: "current" } }];
}

const processId = Astro.params.processId ?? "current";
const config = {
  apiBase: import.meta.env.PUBLIC_FA_REPARTO_API_BASE,
  apiPrefix: import.meta.env.PUBLIC_FA_REPARTO_API_PREFIX
};
---

<StarlightPage
  frontmatter={{
    title: "Reparto group-subject matrix",
    description: "Fill and edit the group-subject matrix the teaching plan materializes from.",
    tableOfContents: false
  }}
>
  <RepartoRouteLoading />
  <RepartoGroupSubjectsView client:only="react" config={config} locale={Astro.currentLocale} processId={processId}>
    <RepartoRouteLoading fallback slot="fallback" />
  </RepartoGroupSubjectsView>
</StarlightPage>
