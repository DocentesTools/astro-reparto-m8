---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { RepartoProcessesView } from "@mano8/astro-reparto-m8/default-ui";
import "../scaffold/styles/reparto.css";

const config = {
  apiBase: import.meta.env.PUBLIC_FA_REPARTO_API_BASE,
  apiPrefix: import.meta.env.PUBLIC_FA_REPARTO_API_PREFIX
};
---

<StarlightPage
  frontmatter={{
    title: "Reparto processes",
    description: "Review and manage reparto assignment processes.",
    tableOfContents: false
  }}
>
  <RepartoProcessesView client:load config={config} />
</StarlightPage>
