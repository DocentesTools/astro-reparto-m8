---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { RepartoVersionsView } from "@mano8/astro-reparto-m8/default-ui";
import "../scaffold/styles/reparto.css";

export function getStaticPaths() {
  return [{ params: { processId: "current" } }];
}

const processId = Astro.params.processId ?? "current";
const config = {
  apiBase: import.meta.env.PUBLIC_FA_REPARTO_API_BASE,
  apiPrefix: import.meta.env.PUBLIC_FA_REPARTO_API_PREFIX
};
---

<StarlightPage
  frontmatter={{
    title: "Reparto versions",
    description: "Inspect process versions and compare previous-year state.",
    tableOfContents: false
  }}
>
  <RepartoVersionsView client:load config={config} locale={Astro.currentLocale} processId={processId} />
</StarlightPage>
