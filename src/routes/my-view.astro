---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { RepartoMyView } from "@mano8/astro-reparto-m8/default-ui";
import "../scaffold/styles/reparto.css";

export function getStaticPaths() {
  return [{ params: { processId: "current" } }];
}

const processId = Astro.params.processId ?? "current";

const config = {
  apiBase: import.meta.env.PUBLIC_FA_REPARTO_API_BASE,
  apiPrefix: import.meta.env.PUBLIC_FA_REPARTO_API_PREFIX
};
---

<StarlightPage
  frontmatter={{
    title: "My reparto view",
    description: "Follow your live assignment turn and available choices.",
    tableOfContents: false
  }}
>
  <RepartoMyView client:load config={config} processId={processId} />
</StarlightPage>
