---
import { RepartoExportCenterView } from "@mano8/astro-reparto-m8/default-ui";
import "../scaffold/styles/reparto.css";

const { processId } = Astro.params;
const config = {
  apiBase: import.meta.env.PUBLIC_FA_REPARTO_API_BASE,
  apiPrefix: import.meta.env.PUBLIC_FA_REPARTO_API_PREFIX
};
---

<RepartoExportCenterView client:load config={config} processId={processId} />
