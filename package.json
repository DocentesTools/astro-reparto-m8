{
  "name": "@mano8/astro-reparto-m8",
  "version": "2.0.0",
  "description": "Astro integration and headless client for reparto-docente-m8.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DocentesTools/astro-reparto-m8.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "astro-integration",
    "astro",
    "reparto-docente",
    "docentes",
    "m8"
  ],
  "files": [
    "dist",
    "src/routes",
    "src/scaffold",
    "registry.json",
    "registry/r",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/src/integration.js",
    "./api": "./dist/src/runtime/api/index.js",
    "./client": "./dist/src/runtime/client.js",
    "./schemas": "./dist/src/runtime/schemas.js",
    "./decimals": "./dist/src/runtime/decimals.js",
    "./sse": "./dist/src/runtime/sse.js",
    "./auth-adapter": "./dist/src/runtime/authAdapter.js",
    "./fa-auth-bridge": "./dist/src/runtime/faAuthBridge.js",
    "./react": "./dist/src/runtime/react/index.js",
    "./default-ui": "./dist/src/runtime/react/default-ui/index.js",
    "./i18n": "./dist/src/runtime/i18n/index.js",
    "./routes": "./dist/src/runtime/routes.js",
    "./route-access": "./dist/src/runtime/routeAccess.js",
    "./ui": "./dist/src/runtime/ui/index.js",
    "./error-mapping": "./dist/src/runtime/errorMapping.js",
    "./routes/dashboard.astro": "./src/routes/dashboard.astro",
    "./routes/meeting.astro": "./src/routes/meeting.astro",
    "./routes/processes.astro": "./src/routes/processes.astro",
    "./routes/my-view.astro": "./src/routes/my-view.astro",
    "./routes/shared.astro": "./src/routes/shared.astro",
    "./routes/versions.astro": "./src/routes/versions.astro",
    "./routes/exports.astro": "./src/routes/exports.astro",
    "./routes/schools.astro": "./src/routes/schools.astro",
    "./routes/academic-years.astro": "./src/routes/academic-years.astro",
    "./routes/departments.astro": "./src/routes/departments.astro",
    "./routes/teacher-roster.astro": "./src/routes/teacher-roster.astro",
    "./routes/subjects.astro": "./src/routes/subjects.astro",
    "./routes/teaching-groups.astro": "./src/routes/teaching-groups.astro",
    "./routes/classroom-stages.astro": "./src/routes/classroom-stages.astro",
    "./routes/group-subjects.astro": "./src/routes/group-subjects.astro",
    "./routes/settings.astro": "./src/routes/settings.astro",
    "./routes/allocation.astro": "./src/routes/allocation.astro",
    "./routes/planning.astro": "./src/routes/planning.astro",
    "./routes/requirements.astro": "./src/routes/requirements.astro",
    "./routes/participants.astro": "./src/routes/participants.astro",
    "./routes/assignments.astro": "./src/routes/assignments.astro",
    "./routes/audit.astro": "./src/routes/audit.astro",
    "./compatibility": "./dist/src/runtime/compatibility.js"
  },
  "types": "./dist/src/integration.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:registry",
    "build:registry": "node scripts/build-registry.mjs",
    "preview:dev": "vite --config fixtures/preview/vite.config.ts",
    "preview:build": "tsc -p fixtures/preview/tsconfig.json --noEmit && vite build --config fixtures/preview/vite.config.ts",
    "refresh:served-surface": "node scripts/refresh-served-surface.mjs",
    "verify:contract-operations": "node scripts/verify-contract-operations.mjs",
    "verify:fleet-gates": "node scripts/verify-fleet-gates.mjs",
    "verify:registry-consumer": "node scripts/verify-registry-consumer.mjs",
    "verify:registry-drift": "node scripts/verify-registry-drift.mjs",
    "verify:starter-routes": "node scripts/verify-starter-routes.mjs",
    "verify:tarball-install": "node scripts/verify-tarball-install.mjs",
    "test": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@mano8/astro-ui-m8": "^1.5.0",
    "radix-ui": "^1.5.0",
    "sonner": "^2.0.7"
  },
  "peerDependencies": {
    "@astrojs/react": "^6.0.1",
    "@astrojs/starlight": "^0.41.3",
    "@mano8/astro-auth-m8": "^2.4.0",
    "@tanstack/react-query": "^5.101.1",
    "astro": "^7.0.8",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@astrojs/react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@astrojs/react": "^6.0.4",
    "@astrojs/starlight": "^0.41.10",
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@eslint/js": "^10.0.1",
    "@mano8/astro-auth-m8": "^2.4.0",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-table": "^8.21.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^4.1.11",
    "astro": "^7.2.9",
    "eslint": "^10.9.1",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "zod": "^4.5.4"
  },
  "repartoDocenteM8": {
    "contract": "reparto-docente-m8@2.0.0",
    "testedServiceVersion": "2.0.0",
    "serviceVersionRange": ">=2.0.0 <3.0.0"
  }
}
